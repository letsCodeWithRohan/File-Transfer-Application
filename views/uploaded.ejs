<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Uploaded Files - File Storage</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen transition-colors duration-300">
    <div class="container mx-auto px-4 py-8 sm:py-12">
        <div class="max-w-4xl mx-auto">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
                <div>
                    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">Uploaded Files</h1>
                    <p class="text-slate-500 dark:text-slate-400 mt-1"><%= files.length %> file(s) stored</p>
                </div>
                <a href="/" class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white font-medium px-5 py-2.5 rounded-xl shadow-lg shadow-blue-500/20 transition-all active:scale-95 self-start sm:self-auto">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Upload More
                </a>
            </div>

            <!-- Files Grid -->
            <% if (files.length === 0) { %>
                <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl rounded-2xl shadow-xl dark:shadow-slate-950/50 border border-slate-100 dark:border-slate-700/50 p-12 text-center">
                    <div class="w-16 h-16 bg-slate-100 dark:bg-slate-700/50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400 dark:text-slate-500">
                        <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <p class="text-lg font-semibold text-slate-800 dark:text-slate-200">No files uploaded yet</p>
                    <a href="/" class="text-blue-600 dark:text-blue-400 font-medium hover:underline mt-2 inline-block">Upload your first file</a>
                </div>
            <% } else { %>
                <div class="grid gap-4">
                    <% files.forEach(file => { %>
                        <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl rounded-2xl shadow-sm hover:shadow-md dark:shadow-slate-950/50 border border-slate-100 dark:border-slate-700/50 p-5 transition-all">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div class="flex items-center space-x-4 min-w-0">
                                    <div class="w-12 h-12 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center flex-shrink-0">
                                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h3 class="text-base font-semibold text-slate-800 dark:text-slate-100 truncate"><%= file.name %></h3>
                                        <div class="flex items-center space-x-2 text-xs text-slate-500 dark:text-slate-400 mt-1">
                                            <span class="font-medium text-slate-700 dark:text-slate-300"><%= file.size %></span>
                                            <span>•</span>
                                            <span><%= file.uploadDate %></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2 self-end sm:self-auto flex-shrink-0">
                                    <a href="/download/<%= file.name %>" class="bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 text-white font-medium px-4 py-2 rounded-lg text-sm shadow-sm transition-all active:scale-95">
                                        Download
                                    </a>
                                    <button onclick="deleteFile('<%= file.name %>')" class="bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-900/50 font-medium px-4 py-2 rounded-lg text-sm transition-all active:scale-95 border border-rose-200 dark:border-rose-800/40">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function deleteFile(filename) {
            if (confirm(`Are you sure you want to delete ${filename}?`)) {
                fetch(`/delete/${filename}`, { method: 'DELETE' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        }
                    });
            }
        }
    </script>
</body>
</html>