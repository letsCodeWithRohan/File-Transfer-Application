<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Files - File Storage</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .drag-over {
            border-color: #3b82f6 !important;
            background-color: rgba(59, 130, 246, 0.1) !important;
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen transition-colors duration-300">
    <div class="container mx-auto px-4 py-8 sm:py-12">
        <div class="max-w-3xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-8 sm:mb-10">
                <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3">
                    File Storage Platform
                </h1>
                <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-xl mx-auto">
                    Upload files up to <span class="font-semibold text-slate-800 dark:text-slate-200">10GB</span> — High-speed local network transfer
                </p>
                <div class="mt-4 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50">
                    <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse mr-2"></span>
                    Server IP: <%= serverIP %>
                </div>
            </div>

            <!-- Upload Area -->
            <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl rounded-2xl shadow-xl dark:shadow-slate-950/50 border border-slate-100 dark:border-slate-700/50 p-6 sm:p-10 mb-6 transition-all">
                <div id="dropZone" class="border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-xl p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 hover:border-blue-500 dark:hover:border-blue-400 hover:bg-slate-50/50 dark:hover:bg-slate-800/50 group">
                    <div class="w-16 h-16 bg-blue-50 dark:bg-blue-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-200">
                        <svg class="h-8 w-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                        </svg>
                    </div>
                    <p class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-1">Drag & Drop files here</p>
                    <p class="text-sm text-slate-400 dark:text-slate-500 mb-5">or select them from your computer</p>
                    
                    <button type="button" onclick="document.getElementById('fileInput').click()" class="bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white font-medium px-6 py-2.5 rounded-xl shadow-lg shadow-blue-500/25 transition-all transform active:scale-95">
                        Browse Files
                    </button>
                    <input type="file" id="fileInput" class="hidden" multiple>
                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-5">Maximum file size: 10GB</p>
                </div>
            </div>

            <!-- File List -->
            <div id="fileList" class="space-y-3 mb-6"></div>

            <!-- Upload Button -->
            <button id="uploadBtn" class="w-full bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 text-white py-4 rounded-xl shadow-lg shadow-emerald-600/20 font-semibold text-lg transition-all transform active:scale-[0.99] disabled:bg-slate-300 dark:disabled:bg-slate-800 disabled:text-slate-500 disabled:shadow-none disabled:cursor-not-allowed hidden">
                Start Upload
            </button>

            <!-- View Uploaded Files -->
            <a href="/uploaded" class="inline-flex items-center justify-center w-full text-sm font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 mt-6 group transition-colors">
                <span>View Uploaded Files</span>
                <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </a>
        </div>
    </div>

    <script src="/js/upload.js"></script>
</body>
</html>